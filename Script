from selenium import webdriver
from selenium.webdriver.chrome.service import Service
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC
import time
import pandas as pd

service = Service("C:/Users/joas.jesus/Desktop/chromedriver.exe")
driver = webdriver.Chrome(service=service)
driver.get("https://envios.adminml.com/logistics/first-mile/monitoring")

# Espera login manual
print("Aguarde e faça login manualmente...")
WebDriverWait(driver, 120).until(
    EC.presence_of_element_located((By.CSS_SELECTOR, "div.monitoring-row-higher"))
)
print("✅ Login detectado! Coletando rotas...")

dados = []

# Coleta todos os cards de rotas
cards = driver.find_elements(By.CSS_SELECTOR, "div.andes-card.monitoring-row-higher")

for i, card in enumerate(cards):
    try:
        print(f"Abrindo rota {i+1}/{len(cards)}...")
        driver.execute_script("arguments[0].scrollIntoView(true);", card)
        time.sleep(1)
        card.click()

        # Espera os detalhes carregarem
        detalhes = WebDriverWait(driver, 20).until(
            EC.presence_of_element_located((By.CSS_SELECTOR, "div.monitoring-row-higher-details"))
        )

        # Coleta todos os textos da página
        textos = [el.text for el in driver.find_elements(By.CSS_SELECTOR, "div.monitoring-row-higher-details p")]
        dados.append(textos)

        # Volta para a página anterior
        driver.back()
        WebDriverWait(driver, 20).until(
            EC.presence_of_element_located((By.CSS_SELECTOR, "div.monitoring-row-higher"))
        )
    except Exception as e:
        print(f"❌ Erro na rota {i+1}: {e}")

# Salvar no Excel
df = pd.DataFrame(dados)
df.to_excel("rotas_detalhadas.xlsx", index=False)
print("✅ Dados salvos em rotas_detalhadas.xlsx")
